{
  "name": "sillage",
  "version": "1.0.0",
  "private": true,
  "description": "A fragrance house's private formula room.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devtechedge/sillage.git"
  },
  "homepage": "https://sillage-one-mu.vercel.app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/prepare-test-db.mjs && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/prepare-test-db.mjs && vitest run tests/integration",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:status": "prisma migrate status",
    "e2e": "npm run build && node scripts/prepare-e2e-db.mjs && playwright test",
    "check:live": "node scripts/live-check.mjs",
    "vercel-build": "next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
